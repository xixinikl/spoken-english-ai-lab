#!/bin/bash
# Launcher for the Gate Log app bundle.
# Resolves to the "gate-log" folder that this .app lives inside,
# starts the local backend if it isn't already running, then opens
# the page in the default browser.

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd)"
cd "$DIR" || exit 1

PORT=8420
LOG_FILE="/tmp/gate-log-server.log"

if ! curl -s "http://127.0.0.1:$PORT/api/data" > /dev/null 2>&1; then
  PYTHON_BIN="$(command -v python3)"
  if [ -z "$PYTHON_BIN" ]; then
    osascript -e 'display alert "Gate Log needs Python 3" message "Install Xcode Command Line Tools (run: xcode-select --install in Terminal) or Python from python.org, then try again."'
    exit 1
  fi
  nohup "$PYTHON_BIN" server.py > "$LOG_FILE" 2>&1 &
  sleep 1
fi

open "http://127.0.0.1:$PORT"
